{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDrobo",
  "version": "0.2.0",
  "identifier": "dev.hypler.OpenDrobo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "OpenDrobo Dashboard", "width": 1120, "height": 800, "minWidth": 860, "minHeight": 640}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion": "14.0", "signingIdentity": "-"}
  }
}
